/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    viRusneRd5/cmvresistancefinder Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null
    input_type                 = "short-read" //one of: short-read (Illumina reads), long-read (ONT reads), fasta (Sanger / assembled per-gene consensus sequences)
    protocol                   = null //one of: amplicon, wgs (required)
    run_name                   = null
    report_author              = null

    // References
    cmv_ref_fasta                = "${projectDir}/assets/NC_006273.2.fasta"
    cmv_ref_gff                  = "${projectDir}/assets/NC_006273.2.gff" //this file has to end in .gff (cannot be .gff3)
    cmv_ref_name                 = 'NC_006273.2' //This must be the name in the header of the fasta file!

    // Trimming, host-removal and FastQC options
    trimmer                      = "fastp" //one of trimmomatic or fastp
    adapter_file                 = null //this is for trimmomatic.
    skip_host_removal            = false //boolean
    hostile_index                = 'human-t2t-hla'
    hostile_reference_path       = null //need to specify hostile reference directory
    kraken2_db                   = null //need to specify kraken2 virus database to identify cmv reads.
    kraken2_output               = false
    skip_kraken2                 = false

    // Variant Calling, aligning
    variant_caller                = "all" //"all", or a comma-separated subset of: ivar, freebayes, lofreq (e.g. "ivar,freebayes")
    aligner                      = "bwa-mem3" //one of minimap2, bwa-mem3 or bowtie2 (long-read input forces minimap2)
    min_depth                    = 40
    min_freq                     = 0.05
    min_mapq                     = 20 //minimum read mapping quality for variant calling (all three callers)
    min_base_quality             = 20 //minimum base quality to count a base towards a variant call (all three callers)

    // FASTA (consensus) input options (only used when --input_type is fasta)
    include_frameshifts          = false //call frameshift indels from a consensus alignment (low confidence, off by default)
    fasta_min_identity           = 0.9 //warn when a consensus record aligns to its gene below this identity

    // Gene consensus export (both input types)
    export_gene_consensus        = false //write a per-gene consensus FASTA per sample to <outdir>/gene_consensus
    consensus_ambig_freq         = 0.2 //FASTQ input: minor-allele fraction above which samtools consensus emits an IUPAC ambiguity code

    // Strain genotyping (short-read/long-read only; independent of --export_gene_consensus)
    genotype_gb                   = false //genotype UL55 (gB) by nearest-neighbour identity against a curated reference panel
    genotype_gn                   = false //genotype UL73 (gN) by nearest-neighbour identity against a curated reference panel
    genotype_genes_bed            = "${projectDir}/assets/genotype_genes.bed" //chrom/start/end/gene regions to build a genotyping consensus over
    genotype_min_depth            = 10 //depth below which a genotyping-consensus position becomes N - deliberately much lower than --min_depth: genotyping just needs one representative base per position (not a confident variant call), and low-titer/LoD samples that can't reach --min_depth (40x) can often still be genotyped
    gb_genotype_references        = "${projectDir}/assets/gb_genotype_references.fasta" //gB1-4 reference panel (header = genotype label)
    gn_genotype_references        = "${projectDir}/assets/gn_genotype_references.fasta" //gN1/gN2/gN3a/gN3b/gN4a/gN4b/gN4c/gN4d reference panel (header = genotype label)
    genotype_min_region_covered   = 0.05 //minimum fraction of the gene with non-N consensus before attempting a call (not a "whole gene" requirement - amplicon assays covering a small, informative fraction of a large gene are expected)
    genotype_min_compared_bases   = 300 //minimum informative bases aligned against the best-matching reference to trust an identity score - the real quality gate for partial coverage
    genotype_ambiguous_margin     = 1.0 //report "ambiguous (X/Y)" if the best and second-best identity are within this many percentage points of each other
    genotype_unresolved_floor     = 90.0 //report "unresolved" if the best identity match is below this percentage

    // Idenitifying resistance mutations
    cmv_resis_db                 = "${projectDir}/assets/final_pheno_meta_analysis_20260827.csv"
    cmv_resis_db_version         = "27-08-2026"

    // Report file things
    cmv_genes_bed                = "${projectDir}/assets/CMV_NC_006273.2_resis_genes.bed" //This bed file contains the start and end location of the six genes involved in CMV antiviral resistance (UL27, UL51, UL54, UL56, UL89 [UL89 has an intron in the middle so will come out with two CDS locations] and UL97)
    mut_bed                      = "${projectDir}/assets/resistance_sites.bed"
    bibliography                 = "${projectDir}/assets/cmv_resis_db_bibliography.bib" //this puts citations in the report.
    skip_sample_report           = false //boolean

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy' //set to 'link' (hard link - free, zero extra disk space) if --outdir is on the same filesystem as Nextflow's work directory, which is the common case
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    // The pipeline currently requires BOTH conda and a container engine: most
    // tools run from their (Seqera/Wave) containers, but a few modules - the
    // Quarto reports - have no usable published container and fall back to
    // conda. Until every module has a working container (or every tool a working
    // conda env) a `conda_<engine>` hybrid is the only supported way to run it.
    // `conda_singularity` is what CI uses and is the most tested.
    conda_singularity {
        conda.enabled          = true
        conda.channels         = ['conda-forge', 'bioconda']
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    conda_docker {
        conda.enabled          = true
        conda.channels         = ['conda-forge', 'bioconda']
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    test       { includeConfig 'conf/test.config'       }
    test_fasta { includeConfig 'conf/test_fasta.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load viRusneRd5/cmvresistancefinder custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
    // Some HPC profiles (e.g. SLURM's /etc/profile.d/slurm.sh) export a host
    // PERL5LIB into every shell, which leaks into tasks/containers and breaks
    // Perl-based tools (fastqc, kraken2, ...). Neutralise it for all tasks.
    PERL5LIB         = ""
}

// Hash cacheable task inputs by path+size only, not modification time. The
// default ('true') includes mtime, which is fragile on shared/networked
// filesystems and any workflow where the pipeline's own checkout can get
// touched (e.g. a `git checkout`) between resumes without its content
// actually changing - both silently break -resume otherwise.
process.cache = 'lenient'

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'viRusneRd5/cmvresistancefinder'
    contributors    = [
        [
            name: 'Jocelyn Hume',
            affiliation: 'The University of Queensland',
            email: 'j.hume@uq.edu.au',
            github: 'https://github.com/viRusneRd5',
            contribution: ['author'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: 'https://orcid.org/0000-0002-1092-4958'
        ],
    ]
    homePage        = 'https://github.com/viRusneRd5/cmvresistancefinder'
    description     = """Identifies cytomegalovirus (CMV) antiviral resistant mutations from short- and long-read sequencing data."""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.8.0' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
