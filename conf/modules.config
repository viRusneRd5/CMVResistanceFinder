/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
    withName: 'SAMTOOLS_SORT' {
      ext.prefix = { "${meta.id}.sorted" }
    }

    withName: 'SNPEFF_BUILD' {
      publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename ->
            filename.endsWith('snpeff_db') || filename.endsWith('.config') || filename.endsWith('.yml') ? filename : null
            }
      ]
    }
    withName: 'SNPEFF_IVAR' {
      ext.prefix = { "${meta.id}_ivar" }
      publishDir = [
          path: "${params.outdir}/vcf_files/ivar/snpeff",
          mode: params.publish_dir_mode,
          pattern: '*.{csv,txt,html,vcf}'
      ]
    }
    withName: 'SNPEFF_FREEBAYES' {
      ext.prefix = { "${meta.id}_freebayes" }
      publishDir = [
          path: "${params.outdir}/vcf_files/freebayes/snpeff",
          mode: params.publish_dir_mode,
          pattern: '*.{csv,txt,html,vcf}'
      ]
    }
    withName: 'SNPEFF_LOFREQ' {
      ext.prefix = { "${meta.id}_lofreq" }
      publishDir = [
          path: "${params.outdir}/vcf_files/lofreq/snpeff",
          mode: params.publish_dir_mode,
          pattern: '*.{csv,txt,html,vcf}'
      ]
    }
    withName: 'SNPSIFT_IVAR' {
      ext.prefix = { "${meta.id}_ivar" }
      publishDir = [
          path: "${params.outdir}/vcf_files/ivar/snpsift",
          mode: params.publish_dir_mode,
          pattern: '*.txt'
      ]
    }
    withName: 'SNPSIFT_FREEBAYES' {
      ext.prefix = { "${meta.id}_freebayes" }
      ext.args = { '"AO[*]" "RO[*]"' }
      publishDir = [
          path: "${params.outdir}/vcf_files/freebayes/snpsift",
          mode: params.publish_dir_mode,
          pattern: '*.txt'
      ]
    }
    withName: 'SNPSIFT_LOFREQ' {
      ext.prefix = { "${meta.id}_lofreq" }
      publishDir = [
          path: "${params.outdir}/vcf_files/lofreq/snpsift",
          mode: params.publish_dir_mode,
          pattern: '*.txt'
      ]
    }
    withName: 'CONSENSUS_VARIANTS' {
      publishDir = [
          [
              path: "${params.outdir}/variant_files",
              mode: params.publish_dir_mode,
              pattern: '*.assessed.tsv'
          ],
          [
              path: "${params.outdir}/gene_consensus",
              mode: params.publish_dir_mode,
              pattern: '*.gene_consensus.fasta',
              enabled: params.export_gene_consensus,
              saveAs: { filename -> filename.replace('.gene_consensus.fasta', '.consensus.fasta') }
          ]
      ]
    }
    withName: 'GENE_CONSENSUS' {
      publishDir = [
          path: "${params.outdir}/gene_consensus",
          mode: params.publish_dir_mode,
          pattern: '*.consensus.fasta'
      ]
    }
    withName: 'GENE_CONSENSUS_GENOTYPE' {
      ext.prefix = { "${meta.id}.genotype" }
      // Not published: this feeds GENOTYPE_CLASSIFY_* only, independent of
      // --export_gene_consensus - not a user-facing output.
      publishDir = [ enabled: false ]
    }
    withName: 'GENOTYPE_CLASSIFY_GB' {
      ext.args = {
          "--min_region_covered ${params.genotype_min_region_covered} " +
          "--min_compared_bases ${params.genotype_min_compared_bases} " +
          "--ambiguous_margin ${params.genotype_ambiguous_margin} " +
          "--unresolved_floor ${params.genotype_unresolved_floor}"
      }
      // Not published: one row per sample - GENOTYPE_MERGE below publishes the
      // single combined run-level file the user actually wants.
      publishDir = [ enabled: false ]
    }
    withName: 'GENOTYPE_CLASSIFY_GN' {
      ext.args = {
          "--min_region_covered ${params.genotype_min_region_covered} " +
          "--min_compared_bases ${params.genotype_min_compared_bases} " +
          "--ambiguous_margin ${params.genotype_ambiguous_margin} " +
          "--unresolved_floor ${params.genotype_unresolved_floor}"
      }
      // Not published: one row per sample - GENOTYPE_MERGE below publishes the
      // single combined run-level file the user actually wants.
      publishDir = [ enabled: false ]
    }
    withName: 'GENOTYPE_MERGE' {
      publishDir = [
          path: "${params.outdir}/genotype",
          mode: params.publish_dir_mode,
          pattern: 'run_genotypes.tsv'
      ]
    }
    withName: 'SNPEFF_SANGER' {
      ext.prefix = { "${meta.id}_sanger" }
      publishDir = [
          path: "${params.outdir}/vcf_files/sanger/snpeff",
          mode: params.publish_dir_mode,
          pattern: '*.{csv,txt,html,vcf}'
      ]
    }
    withName: 'SNPSIFT_SANGER' {
      ext.prefix = { "${meta.id}_sanger" }
      ext.args = { '"MIXED" "MIXED_REF"' }
      publishDir = [
          path: "${params.outdir}/vcf_files/sanger/snpsift",
          mode: params.publish_dir_mode,
          pattern: '*.txt'
      ]
    }
    withName: 'TRIMMOMATIC' {
      ext.args = { "ILLUMINACLIP:${params.adapter_file}:2:30:10 LEADING:3 TRAILING:3 SLIDINGWINDOW:4:15 MINLEN:50" }
      publishDir = [
          path: "${params.outdir}/trimmomatic",
          mode: params.publish_dir_mode,
          pattern: '*.{log,summary}'
      ]
    }
      withName: 'FASTP' {
      // --correction: fix per-base errors in the overlapping region of paired
      //   reads using base quality (relevant here since amplicon inserts are
      //   often short enough for R1/R2 to fully overlap) before variant calling.
      // --trim_poly_g: force poly-G trimming rather than relying on fastp's
      //   auto-detection of 2-colour (NextSeq/NovaSeq) chemistry from the
      //   Illumina instrument ID in the read header, which SRA-downloaded
      //   public data frequently lacks or has stripped.
      ext.args = '--correction --trim_poly_g'
      publishDir = [
          path: "${params.outdir}/fastp",
          mode: params.publish_dir_mode,
          pattern: '*.{json,html,log}'
      ]
    }
    withName: 'RAW_FASTQC' {
      ext.prefix = { "${meta.id}_raw" }
      ext.args = '--quiet'
      publishDir = [
          path: "${params.outdir}/fastqc/raw",
          mode: params.publish_dir_mode,
          pattern: '*.{html,zip}'
      ]
    }
    withName: 'FINAL_FASTQC' {
      ext.prefix = { "${meta.id}_final" }
      ext.args = '--quiet'
      publishDir = [
          path: "${params.outdir}/fastqc/final",
          mode: params.publish_dir_mode,
          pattern: '*.{html,zip}'
      ]
    }
    withName: 'IVAR_VARIANTS' {
      ext.prefix = { "${meta.id}_ivar" }
      ext.args = { "-t ${params.min_freq} -m ${params.min_depth} -q ${params.min_base_quality}" }
      // samtools mpileup feeding ivar: minimum read mapping quality, minimum
      // base quality (belt-and-braces with ivar's own -q above), and no depth
      // cap (the 8000x default would downsample very deep amplicons)
      ext.args2 = { "-q ${params.min_mapq} -Q ${params.min_base_quality} -d 0" }
      publishDir = [
          path: "${params.outdir}/vcf_files/ivar",
          mode: params.publish_dir_mode,
          pattern: '*.tsv'
      ]
    }
    withName: 'IVAR_CONVERT' {
      // Not published: this uncompressed vcf is immediately bgzipped by
      // IVAR_BGZIP below, which publishes the version actually used
      // downstream - no need to keep both.
      publishDir = [ enabled: false ]
    }
    withName: 'IVAR_BGZIP' {
      publishDir = [
          path: "${params.outdir}/vcf_files/ivar",
          mode: params.publish_dir_mode,
          pattern: '*.vcf.gz'
      ]
    }
    withName: 'IVAR_INDEX' {
      publishDir = [
          path: "${params.outdir}/vcf_files/ivar",
          mode: params.publish_dir_mode,
          pattern: '*.vcf.gz.csi'
      ]
    }
    withName: 'FREEBAYES' {
      ext.args = { "--min-alternate-fraction ${params.min_freq} --min-coverage ${params.min_depth} --min-base-quality ${params.min_base_quality} --min-mapping-quality ${params.min_mapq}" }
      // Not published: this raw output is immediately coordinate-sorted by
      // BCFTOOLS_SORT below, which publishes the version actually used
      // downstream - no need to keep both.
      publishDir = [ enabled: false ]
    }
    withName: 'INDEX_FREEBAYES' {
      publishDir = [
          path: "${params.outdir}/vcf_files/freebayes",
          mode: params.publish_dir_mode,
          pattern: '*.vcf.gz.csi'
      ]
    }
    withName: 'LOFREQ_CALL' {
      ext.prefix = { "${meta.id}_lofreq.raw" }
      ext.args = { "-C ${params.min_depth} -q ${params.min_base_quality} -Q ${params.min_base_quality} --min-mq ${params.min_mapq}" }
      // Not published: lofreq call has no minimum-frequency option, so the
      // published vcf is the LOFREQ_FILTER output below (min_freq applied).
      publishDir = [ enabled: false ]
    }
    withName: 'LOFREQ_FILTER' {
      ext.prefix = { "${meta.id}_lofreq" }
      ext.args = { "--no-defaults -a ${params.min_freq}" }
      publishDir = [
          path: "${params.outdir}/vcf_files/lofreq",
          mode: params.publish_dir_mode,
          pattern: '*.vcf.gz'
      ]
    }
    withName: 'INDEX_LOFREQ' {
      publishDir = [
          path: "${params.outdir}/vcf_files/lofreq",
          mode: params.publish_dir_mode,
          pattern: '*.vcf.gz.csi'
      ]
    }
    withName: 'MERGE_FORMAT' {
      ext.args = { "--min_depth ${params.min_depth} --min_freq ${params.min_freq}" }
      publishDir = [
          path: "${params.outdir}/variant_files",
          mode: params.publish_dir_mode,
          pattern: '*.tsv'
      ]
    }
    withName: 'QUARTO_SAMPLE_REPORT' {
      publishDir = [
          path: "${params.outdir}/report_files",
          mode: params.publish_dir_mode,
          pattern: '*.{html,pdf}'
      ]
    }
    withName: 'QUARTO_RUN_REPORT' {
      publishDir = [
          path: "${params.outdir}/report_files",
          mode: params.publish_dir_mode,
          pattern: '*.html'
      ]
    }
    withName: 'RESIS_BED_PREP' {
      publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: null
      ]
    }
    withName: 'SAMPLESHEET_CHECK' {
      publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename ->
            filename.endsWith('.csv') || filename.endsWith('.yml') ? filename : null
            }
      ]
    }
    withName: 'BOWTIE2_ALIGN' {
      // Only the alignment log is kept - the raw bam is immediately
      // coordinate-sorted by SAMTOOLS_SORT, which publishes the bam
      // actually used downstream.
      publishDir = [
        path: "${params.outdir}/bowtie2",
        mode: params.publish_dir_mode,
        pattern: '*.log'
      ]
    }
    withName: 'MINIMAP2_ALIGN' {
      // -x sr: minimap2's short-read preset (paired-end aware seeding/chaining/
      //   scoring) - required for correct short-read alignment; without it
      //   minimap2 falls back to its generic (long-read-oriented) defaults.
      ext.args = { params.input_type == "long-read" ? '-x map-ont' : '-x sr' }
      // Not published: this raw alignment is immediately coordinate-sorted
      // by SAMTOOLS_SORT below, which publishes the bam actually used
      // downstream - no need to keep both.
      publishDir = [ enabled: false ]
    }
    withName: 'MINIMAP2_INDEX' {
      publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename ->
            filename.endsWith('.mmi') ? filename : null
            }
      ]
    }
    withName: 'BWAMEM3_MEM' {
      // Not published: this raw alignment is immediately coordinate-sorted
      // by SAMTOOLS_SORT below, which publishes the bam actually used
      // downstream - no need to keep both.
      publishDir = [ enabled: false ]
    }
    withName: 'BWAMEM3_INDEX' {
      publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename ->
            filename.endsWith('bwamem3') ? filename : null
            }
      ]
    }
    withName: 'BCFTOOLS_SORT' {
      // Publishes the sorted freebayes vcf where the (now-unpublished) raw
      // FREEBAYES output used to live - this is the version actually used
      // downstream.
      publishDir = [
          path: "${params.outdir}/vcf_files/freebayes",
          mode: params.publish_dir_mode,
          pattern: '*.vcf.gz'
      ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
