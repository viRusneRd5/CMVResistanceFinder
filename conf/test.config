/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs the read (short-read) path on a small bundled amplicon-style dataset:
    reads tiled across the six resistance genes of the Merlin reference, with
    UL97 A594V, UL54 A809V, UL27 DEL218, UL51 P91S, UL56 C25F and UL89 N329S
    spiked in. Regenerate the reads with assets/test_data/make_mock_reads.py.

    Use as follows:
        nextflow run viRusneRd5/cmvresistancefinder -profile test,conda_singularity --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal bundled CMV amplicon-style dataset to check pipeline function'

    input             = "${projectDir}/assets/test_data/samplesheet_test.csv"
    input_type        = 'short-read'

    // No large host / Kraken2 databases in CI
    skip_host_removal = true
    skip_kraken2      = true

    // Required params, set here so the test doesn't need them on the command line
    protocol      = 'amplicon'
    run_name      = 'test_run'
    report_author = 'nf-test'
}
