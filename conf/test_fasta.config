/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running a minimal FASTA (Sanger consensus) test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Exercises the --input_type fasta path with a small bundled per-gene
    consensus (UL97 carrying M460V and a mixed A594V/A call, UL54 supplied
    reverse-complemented, UL56 as a partial fragment).

    Use as follows:
        nextflow run viRusneRd5/cmvresistancefinder -profile test_fasta,conda_singularity --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'FASTA test profile'
    config_profile_description  = 'Minimal FASTA (Sanger consensus) dataset to check the --input_type fasta path'

    input                 = "${projectDir}/assets/test_data/samplesheet_fasta.csv"
    input_type            = 'fasta'
    export_gene_consensus = true

    // Required params, set here so the test doesn't need them on the command line
    protocol      = 'amplicon'
    run_name      = 'test_fasta_run'
    report_author = 'nf-test'
}
